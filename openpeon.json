{
    "cesp_version": "1.0",
    "name": "totally-spies-fr",
    "display_name": "Totally spies (FR)",
    "version": "1.0.1",
    "description": "Best of Totally Spies (FR): Jerry, Clover, Sam & Alex <3",
    "author": {
      "name": "Capucine R.",
      "github": "capucineROHART"
    },
    "license": "CC-BY-NC-ND",
    "language": "fr",
    "categories": {
      "session.start": {
        "sounds": [
          { "file": "sounds/compowder.mp3", "label": "Hello from compowder" },
          { "file": "sounds/bonsoir_filles.mp3", "label": "Good evening" },
          { "file": "sounds/quoi_de_neuf.mp3", "label": "What's up" },
          { "file": "sounds/bonjour_mesdemoiselles.mp3", "label": "Hello girls" }
        ]
      },
      "task.acknowledge": {
        "sounds": [
          { "file": "sounds/content_revoir.mp3", "label": "Happy to see you" },
          { "file": "sounds/gadgets.mp3", "label": "Gadgets" }
          
        ]
      },
      "task.complete": {
        "sounds": [
          { "file": "sounds/genial.mp3", "label": "Awesome" },
          { "file": "sounds/fabuleux.mp3", "label": "Marvellous" },
          { "file": "sounds/inutile_remercier.mp3", "label": "No need to thank" }
        ]
      },
      "task.error": {
        "sounds": [
          { "file": "sounds/heure_grave.mp3", "label": "Situation is serious" },
          { "file": "sounds/drame.mp3", "label": "Tragedy" }
        ]
      },
      "input.required": {
        "sounds": [
          { "file": "sounds/faites_vite.mp3", "label": "Hurry" },
          { "file": "sounds/neutraliser.mp3", "label": "Need neutralization" },
          { "file": "sounds/tombe_a_pic.mp3", "label": "Come in handy"}
        ]
      },
      "resource.limit": {
        "sounds": [
          { "file": "sounds/chaos.mp3", "label": "Chaos" },
          { "file": "sounds/en_cours_de_dev.mp3", "label": "Use smoothly" },
          { "file": "sounds/plus_de_mon_ressort.mp3", "label": "Out of my hands" }
        ]
      }
    }
  }
